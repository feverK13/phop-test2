# Get these from https://dashboard.emailjs.com
# 1. Create account and email service connection
# 2. Create email template — variables: from_name, from_email, service, budget, message
# 3. Copy Service ID, Template ID, Public Key here
# Copy this file to .env and fill in. The .env file is gitignored. NEVER commit real values.
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
